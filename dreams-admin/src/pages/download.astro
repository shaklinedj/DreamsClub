        }
        .bg-mesh {
            background-color: #0b0f19;
            background-image: 
                radial-gradient(at 10% 20%, rgba(147, 51, 234, 0.18) 0px, transparent 50%),
                radial-gradient(at 90% 10%, rgba(234, 179, 8, 0.12) 0px, transparent 40%),
                radial-gradient(at 50% 80%, rgba(126, 34, 206, 0.15) 0px, transparent 50%);
        }
    </style>
</head>
<body class="bg-mesh text-slate-100 min-h-screen flex flex-col justify-between selection:bg-purple-500 selection:text-white">

    <!-- Header / Navbar -->
    <header class="border-b border-slate-800/80 backdrop-blur-md sticky top-0 z-50 bg-slate-950/60">
