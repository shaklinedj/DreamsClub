                                </div>
                            </div>
                            <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-800/60 border border-slate-700/50">
                                <span class="text-xl">🎁</span>
                                <div>
                                    <p class="font-bold text-white text-xs">Ruleta & Minijuegos</p>
                                    <p class="text-slate-400 text-[11px]">Premios y créditos todos los días</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-800/60 border border-slate-700/50">
                                <span class="text-xl">💬</span>
                                <div>
                                    <p class="font-bold text-white text-xs">Stickers de WhatsApp</p>
                                    <p class="text-slate-400 text-[11px]">Instala packs temáticos con 1 clic</p>
                                </div>
                            </div>
                        </div>

                        <!-- Scan QR Info -->
                        <div class="bg-slate-950/70 border border-slate-800 rounded-2xl p-4 text-center">
                            <p class="text-xs text-slate-300 font-medium mb-1">¿Estás en tu computadora?</p>
                            <p class="text-[11px] text-slate-400">Abre este enlace en tu teléfono móvil para descargar la app directamente.</p>
