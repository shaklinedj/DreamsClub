                </div>

                <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 hover:border-emerald-500/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                        💎
                    </div>
                    <h3 class="font-bold text-white text-lg mb-2">Beneficios VIP</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Descuentos exclusivos en restaurantes, bar, hotelería y promociones especiales en sala.
                    </p>
                </div>

                <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 hover:border-blue-500/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                        🎨
                    </div>
                    <h3 class="font-bold text-white text-lg mb-2">Stickers de WhatsApp</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Exporta packs oficiales de stickers animados directamente a tu WhatsApp con un solo clic.
                    </p>
                </div>

            </div>
        </section>

        <!-- Casinos List -->
        <section class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
            <div class="text-center space-y-2">
                <h3 class="text-xl font-bold text-white font-heading">Disponible para nuestros 8 Casinos</h3>
                <p class="text-xs text-slate-400">Encuentra información, eventos y promociones en cada una de nuestras sedes:</p>
            </div>
            
            <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-semibold text-slate-300">
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Monticello</span>
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Iquique</span>
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Temuco</span>
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Valdivia</span>
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Puerto Varas</span>
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Coyhaique</span>
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Punta Arenas</span>
                <span class="px-3.5 py-1.5 rounded-full bg-slate-800 border border-slate-700">📍 Talca</span>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950/80 py-8 text-center text-xs text-slate-500">
        <p>© 2026 DreamsClub • Casinos Dreams. Todos los derechos reservados.</p>
        <p class="mt-1">Juega responsablemente. Solo para mayores de 18 años.</p>
    </footer>

    <!-- Deep Link check script -->
    <script is:inline>
        // Detect if user is inside an in-app browser / webview (like WhatsApp or Facebook)
        const isWebview = /FBAN|FBAV|Instagram|WhatsApp|wv|WebView/i.test(navigator.userAgent);
        if (isWebview) {
            const warningEl = document.getElementById('webviewWarning');
            if (warningEl) {
                warningEl.classList.remove('hidden');
            }
        }

        // Check query parameters to customize the open app link
        const urlParams = new URLSearchParams(window.location.search);
        const postId = urlParams.get('postId');

        if (postId) {
            const openAppBtn = document.getElementById('openAppBtn');
            if (openAppBtn) {
                openAppBtn.href = `dreamsclub://post/${postId}`;
            }
        }
    </script>
</body>
</html>
