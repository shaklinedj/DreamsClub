---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Descargar DreamsClub - App Oficial Casinos Dreams</title>
    <meta name="description" content="Descarga la aplicación oficial DreamsClub para Android. Disfruta de beneficios VIP, ruleta diaria, cartelera de shows y stickers exclusivos de Casinos Dreams." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Descarga DreamsClub App" />
    <meta property="og:description" content="Accede a beneficios exclusivos, cartelera de shows, ruleta de premios y stickers de WhatsApp en los 8 casinos Dreams." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://dreams-casino-app.web.app/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        h1, h2, h3, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        .glow-gold {
            box-shadow: 0 0 40px -10px rgba(234, 179, 8, 0.4);
        }
        .glow-purple {
