---
import AdminLayout from '../layouts/AdminLayout.astro';
import FeedList from '../components/FeedList';
---

<AdminLayout title="Gestión del Feed">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-white mb-2">Feed & Publicaciones</h2>
            <p class="text-slate-400">Modera y crea contenido para la comunidad.</p>
        </div>
        <a href="/feed/new" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
            <span class="text-xl">+</span> Nueva Publicación
        </a>
    </div>

    <div class="mt-8">
        <FeedList client:load />
    </div>
</AdminLayout>
