---
import AdminLayout from '../layouts/AdminLayout.astro';
import GameList from '../components/GameList';
---

<AdminLayout title="Gestión de Juegos">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-white mb-2">Juegos</h2>
            <p class="text-slate-400">Configura disponibilidad y reglas de los juegos.</p>
        </div>
        <button class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
            <span class="text-xl">+</span> Nuevo Juego
        </button>
    </div>

    <GameList client:load />
</AdminLayout>
