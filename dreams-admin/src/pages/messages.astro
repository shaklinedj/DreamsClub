---
import AdminLayout from '../layouts/AdminLayout.astro';
import NotificationManager from '../components/NotificationManager';
---

<AdminLayout title="Transmisor de Notificaciones">
    <div class="max-w-4xl mx-auto">
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-white mb-2">Notificaciones In-App</h2>
            <p class="text-slate-400">Transmite alertas y avisos en tiempo real directo a las pantallas de los usuarios en la app móvil.</p>
        </div>

        <NotificationManager client:load />
    </div>
</AdminLayout>

