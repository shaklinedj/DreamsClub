{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-adhoc.log"
            ],
            "predeploy": []
        }
    ],
    "hosting": {
        "public": "dreams-admin/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "/downloads/DreamsClub.bin",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/vnd.android.package-archive"
                    },
                    {
                        "key": "Content-Disposition",
                        "value": "attachment; filename=DreamsClub.apk"
                    }
                ]
            },
            {
                "source": "/downloads/**",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/vnd.android.package-archive"
                    },
                    {
                        "key": "Content-Disposition",
                        "value": "attachment; filename=DreamsClub.apk"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "dreams-casino-app",
                    "appId": "1:326453914816:android:f9a04e57ae0461e6291125",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "dreams-casino-app",
                    "configurations": {
                        "android": "1:326453914816:android:f9a04e57ae0461e6291125",
                        "ios": "1:326453914816:ios:cf228c2d641293a0291125",
                        "web": "1:326453914816:web:7dff6793ffc873fb291125"
                    }
                }
            }
        }
    }
}