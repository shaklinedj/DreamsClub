rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is an administrator
    function isAdmin() {
      return isAuthenticated() && 
        (
          // Check the user document field 'isAdmin'
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          ||
          // Fallback check for Hernan Laurel
          request.auth.token.email == 'hernan.laurel@gmail.com'
        );
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Users can only create their document if they are the owner and don't set isAdmin to true
      allow create: if isAuthenticated() && isOwner(userId) && 
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      // Users can only update their own details (cannot modify isAdmin)
      allow update: if isAdmin() || (
        isAuthenticated() && isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) || request.resource.data.isAdmin == resource.data.isAdmin)
      );
      allow delete: if isAdmin();

      // Subcollection: prizes (duplicate won prizes for user rules checking)
      match /prizes/{prizeId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Subcollection: game_history
      match /game_history/{gameId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // Collection: mini_game_prizes
    match /mini_game_prizes/{prizeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: game_rules_config
    match /game_rules_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: game_configs
    match /game_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: user_prizes
    match /user_prizes/{prizeId} {
      // Admins/cashiers can read any prize for verification. Normal users can only read their own prizes.
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email);
      
      // Creating a new won prize is allowed for owners when they win
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.userId == request.auth.token.email
      );

      // Only admins or cashiers can update (burn) prizes (e.g. status: 'cobrado', redeemed: true)
      allow update: if isAdmin();
      
      // Nobody should delete prizes for auditing trail
      allow delete: if false;
    }

    // Collection: posts
    match /posts/{postId} {
      allow read: if true;
      // Allow creation/deletion only by admin
      allow create, delete: if isAdmin();
      // Allow update by admin, or by normal users who are only changing counters or reaction map
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'reactionsCount', 'reactionCounts', 'userReactions', 'updatedAt'])
      );

      // Subcollection: comments
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.userId == request.auth.uid || 
          request.resource.data.userId == request.auth.token.email
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.userId == request.auth.token.email || 
          isAdmin()
        );
      }

      // Subcollection: reactions
      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && (
          reactionId == request.auth.uid ||
          reactionId == request.auth.token.email ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.userId == request.auth.token.email
        );
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.token.email ||
          isAdmin()
        );
      }
    }

    // Collection: stickers
    match /stickers/{stickerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: config
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: carteleras
    match /carteleras/{carteleraId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: casinos
    match /casinos/{casinoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: user_visits
    match /user_visits/{visitId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || resource.data.user_id == request.auth.token.email || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || request.resource.data.user_id == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Collection: user_points_history
    match /user_points_history/{pointId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || resource.data.user_id == request.auth.token.email || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || request.resource.data.user_id == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Allow collection group queries on reactions subcollection globally
    match /{path=**}/reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && (
        reactionId == request.auth.uid ||
        reactionId == request.auth.token.email ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.token.email
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        isAdmin()
      );
    }

    // Fallback: Default deny all other collections to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
