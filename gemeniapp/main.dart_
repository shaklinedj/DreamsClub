  @override
  Widget build(BuildContext context) {
    final List<Widget> widgetOptions = <Widget>[
      _buildHomeTab(),
      _buildCasinosTab(),
      _buildRewardsTab(),
      _buildProfileTab(context), // Pasamos context para navegación
