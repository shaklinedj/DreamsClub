// --- PANTALLA DE CONFIGURACIÓN DE PERMISOS (NUEVA) ---

class SettingsScreen extends StatefulWidget {
  const SettingsScreen({super.key});

  @override
  State<SettingsScreen> createState() => _SettingsScreenState();
}

class _SettingsScreenState extends State<SettingsScreen> {
  // Estado simulado de permisos
  bool _gpsEnabled = false;
  bool _cameraEnabled = false;
  bool _notificationsEnabled = true;

  // Simula una petición asíncrona de permisos
  Future<void> _togglePermission(String type, bool value) async {
    if (value) {
      // Mostrar un indicador de carga o diálogo simulando el sistema operativo
      showDialog(
        context: context,
        barrierDismissible: false,
        builder: (context) => const Center(child: CircularProgressIndicator(color: kGoldColor)),
      );
      
      await Future.delayed(const Duration(milliseconds: 1000)); // Simula espera del usuario
      Navigator.pop(context); // Cierra el loader
    }

    setState(() {
      if (type == 'gps') _gpsEnabled = value;
      if (type == 'camera') _cameraEnabled = value;
      if (type == 'notifications') _notificationsEnabled = value;
    });

    if (value) {
       ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Permiso de $type concedido'),
          backgroundColor: Colors.green[800],
          duration: const Duration(seconds: 1),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Configuración', style: TextStyle(color: kGoldColor, fontWeight: FontWeight.bold)),
        backgroundColor: kBackgroundColor,
        iconTheme: const IconThemeData(color: Colors.white),
        centerTitle: true,
      ),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          const Text(
            'PERMISOS DE LA APLICACIÓN',
            style: TextStyle(color: Colors.grey, fontSize: 12, fontWeight: FontWeight.bold, letterSpacing: 1.2),
          ),
          const SizedBox(height: 20),
          
          // GPS Toggle
          _buildPermissionTile(
            title: 'Ubicación (GPS)',
            subtitle: 'Para encontrar casinos Dreams cercanos y ofertas locales.',
            icon: Icons.location_on,
            value: _gpsEnabled,
            onChanged: (v) => _togglePermission('gps', v),
          ),
          
          const SizedBox(height: 16),

          // Camera Toggle
          _buildPermissionTile(
            title: 'Cámara',
            subtitle: 'Necesario para escanear códigos QR de promociones.',
            icon: Icons.camera_alt,
            value: _cameraEnabled,
            onChanged: (v) => _togglePermission('camera', v),
          ),

          const SizedBox(height: 16),

          // Notifications Toggle
          _buildPermissionTile(
            title: 'Notificaciones',
            subtitle: 'Recibe alertas sobre sorteos, ganadores y premios exclusivos.',
            icon: Icons.notifications_active,
            value: _notificationsEnabled,
            onChanged: (v) => _togglePermission('notifications', v),
          ),

          const SizedBox(height: 40),
          const Divider(color: Colors.white10),
          const SizedBox(height: 20),
          
          const Text(
            'INFORMACIÓN LEGAL',
            style: TextStyle(color: Colors.grey, fontSize: 12, fontWeight: FontWeight.bold, letterSpacing: 1.2),
          ),
          ListTile(
            contentPadding: EdgeInsets.zero,
            title: const Text('Términos y Condiciones', style: TextStyle(color: Colors.white)),
            trailing: const Icon(Icons.chevron_right, color: Colors.grey),
            onTap: () {},
          ),
          ListTile(
            contentPadding: EdgeInsets.zero,
            title: const Text('Política de Privacidad', style: TextStyle(color: Colors.white)),
            trailing: const Icon(Icons.chevron_right, color: Colors.grey),
            onTap: () {},
          ),
          const SizedBox(height: 20),
          const Center(
            child: Text(
              'Versión 1.0.5 (Build 220)',
              style: TextStyle(color: Colors.grey, fontSize: 12),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPermissionTile({
    required String title,
    required String subtitle,
    required IconData icon,
    required bool value,
    required Function(bool) onChanged,
  }) {
    return Container(
      decoration: BoxDecoration(
        color: kSurfaceColor,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: Colors.white10),
      ),
      child: SwitchListTile(
        value: value,
        onChanged: onChanged,
        activeColor: kGoldColor,
        activeTrackColor: kGoldColor.withValues(alpha : 0.3),
        inactiveThumbColor: Colors.grey,
        inactiveTrackColor: Colors.grey[800],
        title: Row(
          children: [
            Icon(icon, color: value ? kGoldColor : Colors.grey, size: 20),
            const SizedBox(width: 12),
            Text(title, style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
          ],
        ),
        subtitle: Padding(
          padding: const EdgeInsets.only(top: 4.0),
          child: Text(subtitle, style: TextStyle(color: Colors.grey[400], fontSize: 12)),
        ),
      ),
    );
  }
}


// --- WIDGETS AUXILIARES ---

class _NavBarItem extends StatelessWidget {
  final IconData icon;
  final String label;
  final bool isActive;
  final VoidCallback onTap;

  const _NavBarItem({
    required this.icon,
    required this.label,
    required this.isActive,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      behavior: HitTestBehavior.opaque,
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(icon, color: isActive ? kGoldColor : Colors.grey, size: 24),
          const SizedBox(height: 4),
          Text(
            label,
            style: TextStyle(
              color: isActive ? kGoldColor : Colors.grey,
              fontSize: 10,
              fontWeight: FontWeight.w500,
            ),
          ),
        ],
      ),
    );
  }
}

class _QuickActionButton extends StatelessWidget {
  final IconData icon;
  final String label;
  final VoidCallback onTap;

  const _QuickActionButton({
    required this.icon,
    required this.label,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return Material(
      color: kSurfaceLightColor,
      borderRadius: BorderRadius.circular(12),
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(12),
        child: Container(
          padding: const EdgeInsets.all(16),
          decoration: BoxDecoration(
            border: Border.all(color: Colors.white10),
            borderRadius: BorderRadius.circular(12),
          ),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(icon, color: kGoldColor, size: 20),
              const SizedBox(width: 8),
              Text(label, style: const TextStyle(fontWeight: FontWeight.w500)),
            ],
          ),
        ),
      ),
    );
  }
}

class _ProfileButton extends StatelessWidget {
  final String text;
  final VoidCallback onTap;

  const _ProfileButton({required this.text, required this.onTap});

  @override
  Widget build(BuildContext context) {
    return Material(
      color: kSurfaceColor,
      borderRadius: BorderRadius.circular(8),
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(8),
        child: Container(
          padding: const EdgeInsets.all(16),
          decoration: BoxDecoration(
            border: Border.all(color: Colors.white10),
            borderRadius: BorderRadius.circular(8),
          ),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(text, style: const TextStyle(color: Colors.white)),
              const Icon(Icons.chevron_right, size: 16, color: Colors.grey),
            ],
          ),
        ),
      ),
    );
  }
}