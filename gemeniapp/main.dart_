import 'package:flutter/material.dart';
import 'dart:ui';
import 'dart:async'; // Importamos para usar Future.delayed simulando permisos

void main() {
  runApp(const DreamsLoyaltyApp());
}

// --- CONSTANTES DE DISEÑO ---
const Color kGoldColor = Color(0xFFD4AF37);
const Color kBackgroundColor = Colors.black;
const Color kSurfaceColor = Color(0xFF1A1A1A);
const Color kSurfaceLightColor = Color(0xFF2A2A2A);

// --- MODELOS DE DATOS (MOCK) ---
class Casino {
  final String id;
  final String name;
  final String city;
  final String region;
  final String desc;
  final List<String> features;

  Casino(this.id, this.name, this.city, this.region, this.desc, this.features);
}

final List<Casino> casinos = [
  Casino('monticello', 'Monticello', 'San Francisco de Mostazal', 'Región de O\'Higgins',
      'El centro de entretención más grande de Latinoamérica.', ['Arena Monticello', 'Hotel 5 Estrellas', 'Paseo Murano']),
  Casino('iquique', 'Dreams Iquique', 'Iquique', 'Región de Tarapacá',
      'A pasos de playa Cavancha, diversión frente al mar.', ['Playa Cavancha', 'Shows en Vivo', 'Gastronomía']),
  Casino('temuco', 'Dreams Temuco', 'Temuco', 'Región de La Araucanía',
      'En el corazón de la Araucanía, lujo y cultura.', ['Spa Hydra', 'Centro de Eventos', 'Hotel Dreams']),
  Casino('valdivia', 'Dreams Valdivia', 'Valdivia', 'Región de Los Ríos',
      'Ubicación privilegiada con vista al Río Calle-Calle.', ['Sky Bar', 'Vista al Río', 'Museo']),
  Casino('puerto-varas', 'Dreams Puerto Varas', 'Puerto Varas', 'Región de Los Lagos',
      'A orillas del Lago Llanquihue, con vista a los volcanes.', ['Lago Llanquihue', 'Entorno Natural', 'Turismo']),
  Casino('coyhaique', 'Dreams Coyhaique', 'Coyhaique', 'Región de Aysén',
      'Diversión en la patagonia chilena.', ['Patagonia', 'Naturaleza', 'Bar Lucky 7']),
  Casino('punta-arenas', 'Dreams Punta Arenas', 'Punta Arenas', 'Región de Magallanes',
      'Entretenimiento en la ciudad más austral del mundo.', ['Estrecho de Magallanes', 'Sky Bar', 'Zona Franca']),
];

class Offer {
  final int id;
  final String title;
  final String type;
  final IconData icon;
  final String validity;
  final int pointsCost;

  Offer(this.id, this.title, this.type, this.icon, this.validity, this.pointsCost);
}

final List<Offer> offers = [
  Offer(1, '30% Dcto. en Bar Lucky 7', 'Gastronomía', Icons.coffee, 'Vence en 3 días', 0),
  Offer(2, 'Noche Gratis - Hotel Dreams', 'Hotel', Icons.hotel, 'Válido todo el año', 60000),
  Offer(3, '\$10.000 Créditos Promocionales', 'Juego', Icons.videogame_asset, 'Vence hoy', 5000),
];

// --- APP PRINCIPAL ---

class DreamsLoyaltyApp extends StatelessWidget {
  const DreamsLoyaltyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Dreams Club',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        brightness: Brightness.dark,
        scaffoldBackgroundColor: kBackgroundColor,
        primaryColor: kGoldColor,
        fontFamily: 'Sans', // Usa la fuente por defecto del sistema
        colorScheme: const ColorScheme.dark(
          primary: kGoldColor,
          secondary: kGoldColor,
          surface: kSurfaceColor,
        ),
        useMaterial3: true,
      ),
      home: const HomeScreen(),
    );
  }
}

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int _selectedIndex = 0;
  
  // Datos de Usuario Mock
  final Map<String, dynamic> user = {
    'name': 'Juan Pérez',
    'tier': 'Platinum',
    'points': 45250,
    'nextTierPoints': 60000,
  };

  void _onItemTapped(int index) {
    setState(() {
      _selectedIndex = index;
    });
  }

  void _showQRModal() {
    showDialog(
      context: context,
      barrierColor: Colors.black.withValues(alpha : 0.9),
      builder: (BuildContext context) {
        return Dialog(
          backgroundColor: Colors.transparent,
          insetPadding: const EdgeInsets.all(20),
          child: Container(
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(24),
            ),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Stack(
                  children: [
                    Container(
                      width: double.infinity,
                      padding: const EdgeInsets.all(24),
                      decoration: const BoxDecoration(
                        color: kSurfaceColor,
                        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
                      ),
                      child: const Column(
                        children: [
                          Text(
                            'DREAMS CLUB',
                            style: TextStyle(
                              color: kGoldColor,
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                              letterSpacing: 2,
                            ),
                          ),
                          SizedBox(height: 4),
                          Text(
                            'Tarjeta de Socio Digital',
                            style: TextStyle(color: Colors.grey, fontSize: 14),
